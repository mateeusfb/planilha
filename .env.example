# Copie para .env.local e preencha com as credenciais reais.
# Painel do Supabase → Project Settings → API.
#
# Ambas são NEXT_PUBLIC_: vão para o bundle do navegador. Isso é o esperado —
# a anon key é pública por design, e o que protege os dados é a RLS.
# NUNCA coloque a service_role key numa variável NEXT_PUBLIC_: ela ignora RLS.

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Agenda / Google Calendar (só no servidor) ────────────────────────────────
# Nada daqui leva NEXT_PUBLIC_: são segredos e só existem dentro das rotas em
# src/app/api/google/**, que rodam no servidor. Variável server-only nunca entra
# no bundle do navegador — é por isso que a service_role pode viver aqui.
# Sem essas variáveis o app roda normal; só a área Agenda fica indisponível.

# Painel do Supabase → Project Settings → API → service_role.
# Ignora RLS por completo. É ela que lê e escreve google_accounts, a única
# tabela do projeto com RLS ligada e ZERO policies (proposital — ver a migration
# 20260819_google_calendar_contas.sql).
SUPABASE_SERVICE_ROLE_KEY=

# Google Cloud Console → APIs e serviços → Credenciais → ID do cliente OAuth
# (tipo "Aplicativo da Web").
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Precisa bater EXATAMENTE com um "URI de redirecionamento autorizado" lá no
# console, incluindo a porta e sem barra no fim.
#   Local:    http://localhost:3000/api/google/callback
#   Produção: https://SEU-DOMINIO/api/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback

# Assina o `state` do OAuth: é o que amarra o retorno do Google ao usuário certo
# e protege contra CSRF. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
GOOGLE_OAUTH_STATE_SECRET=

# Chave AES-256-GCM que cifra os tokens do Google antes de gravar no banco.
# 32 bytes em base64url — mesmo comando acima.
# ⚠️ Se essa chave mudar, os tokens salvos ficam ilegíveis e é só reconectar a
#    conta Google nas Configurações. Nenhum dado é perdido.
GOOGLE_TOKEN_ENC_KEY=
